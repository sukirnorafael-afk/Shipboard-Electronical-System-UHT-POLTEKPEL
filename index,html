const D={};

/* ---- summary modules 1-7 ---- */
D[1]={t:'Atom, Unsur, Senyawa, Molekul, Aliran Elektron & Arus',g:'Ringkasan',c:[
{h:'Pokok Pemahaman'},
{ul:['Atom = proton (+), neutron (0), elektron (−).','Aliran elektron: dari − ke +. Arus konvensional: dari + ke −.','Unsur: zat tunggal. Senyawa: gabungan unsur dengan perbandingan tetap. Molekul: gabungan atom.']},
{h:'Besaran dasar'},
{tbl:{h:['Besaran','Simbol','Satuan','Rumus'],r:[['Muatan','Q','Coulomb','Q = I·t'],['Arus','I','Ampere','I = Q/t'],['Tegangan','V','Volt','V = I·R'],['Daya','P','Watt','P = V·I = I²R']]}},
{n:'Ketika motor pompa pendingin bekerja, arus mengalir melalui belitan stator membentuk medan magnet berputar. Inilah dasar semua pembahasan motor, generator, dan kontrol di modul selanjutnya.'},
