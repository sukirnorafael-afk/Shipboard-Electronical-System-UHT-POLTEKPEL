/* ==== RENDER ==== */
function renderBlock(item){
  if(item.p) return '<p>'+item.p+'</p>';
  if(item.h) return '<h4>'+item.h+'</h4>';
  if(item.ul) return '<ul>'+item.ul.map(x=>'<li>'+x+'</li>').join('')+'</ul>';
  if(item.ol) return '<ol>'+item.ol.map(x=>'<li>'+x+'</li>').join('')+'</ol>';
  if(item.cap) return '<ul class="cap">'+item.cap.map(x=>'<li>'+x+'</li>').join('')+'</ul>';
  if(item.tbl) return tbl(item.tbl.h,item.tbl.r);
  if(item.fl) return flow(item.fl);
  if(item.n) return '<div class="note'+(item.k?' '+item.k:'')+'">'+item.n+'</div>';
  if(item.code) return '<div class="code">'+item.code+'</div>';
  if(item.c) return chips(item.c)+regs(item.c);
  if(item.regs) return regs(item.regs);
  return '';
}

function renderMod(key){
  const m=D[key];
  if(!m) return '<p>Modul tidak ditemukan.</p>';
  return m.c.map(renderBlock).join('');
}

/* ==== MODAL ==== */
const ov=document.getElementById('ov'),mdTtl=document.getElementById('mdTtl'),mdBdg=document.getElementById('mdBdg'),mdBody=document.getElementById('mdBody');
function openMod(key){
  const m=D[key];
  if(!m) return;
  const label=typeof key==='number'?('MODUL '+key):(key==='tot'?'TOT 6.09':key==='ref'?'REFERENSI':'OUTCOME');
  mdBdg.textContent=label+' · '+(m.g||'');
  mdTtl.textContent=m.t;
  mdBody.innerHTML=renderMod(key);
  ov.classList.add('show');
  document.body.style.overflow='hidden';
  ov.scrollTop=0;
}
function closeMod(){ov.classList.remove('show');document.body.style.overflow='';}
document.getElementById('mdCl').addEventListener('click',closeMod);
ov.addEventListener('click',e=>{if(e.target===ov)closeMod();});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMod();});

