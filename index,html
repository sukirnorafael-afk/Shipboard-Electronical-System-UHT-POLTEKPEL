function makeCard(gridId,key,label,tag){
  const m=D[key];if(!m)return;
  const div=document.createElement('div');
  div.className='card';
  div.innerHTML='<div class="num">'+label+'</div><h3>'+m.t+'</h3><p>'+(m.c.find(x=>x.p)?.p?.slice(0,110)+'…'||'Materi detail')+'</p><span class="tag">'+(tag||m.g)+'</span>';
  div.onclick=()=>openMod(key);
  document.getElementById(gridId).appendChild(div);
}

